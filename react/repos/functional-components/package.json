{
  "name": "rs-react-functional-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify:harness": "node scripts/verify-harness.mjs",
    "instructions:sync": "node scripts/sync-instructions.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.4.1",
  "aiCoaching": {
    "note": "This repo uses an AI coaching harness. See CLAUDE.md. Do not disarm it; integrity is checked by scripts/verify-harness.mjs.",
    "instructionFiles": [
      "CLAUDE.md",
      "AGENTS.md",
      "GEMINI.md",
      ".github/copilot-instructions.md",
      ".cursor/rules/coaching.mdc"
    ]
  }
}
