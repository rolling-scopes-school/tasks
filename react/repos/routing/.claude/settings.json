{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "deny": ["mcp__playwright__browser_run_code_unsafe"]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/coach-reminder.mjs\""
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "explain": "on",
    "options": "on",
    "review": "on",
    "test-ideas": "on",
    "debug-coach": "on",
    "quiz-me": "on",
    "defend": "on",
    "log-decision": "on",
    "hooks-review": "off",
    "routing-review": "on",
    "state-review": "off",
    "query-review": "off",
    "a11y-review": "on",
    "composition-review": "off",
    "forms-review": "off",
    "perf-review": "off",
    "rsc-review": "off",
    "e2e-review": "on"
  }
}
